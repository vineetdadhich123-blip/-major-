# QuickPrint Pro - Backend Environment Configuration

# Server Port
PORT=3000
NODE_ENV=development

# Database Configuration
# You can connect to MongoDB (e.g. MongoDB Atlas or local MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/quickprint?retryWrites=true&w=majority
# Example Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/quickprint
MONGODB_URI=

# Database Strategy:
# 'auto'    -> Tries MongoDB first; if unavailable, seamlessly runs on SQLite (quickprint.db)
# 'mongodb' -> Forces MongoDB connection
# 'sqlite'  -> Uses embedded SQLite database (SQL mode)
DB_TYPE=auto

# Maximum upload file size in Megabytes
MAX_FILE_SIZE_MB=25

# Upload storage directory
UPLOAD_DIR=uploads
